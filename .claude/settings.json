{
    "hooks": {
        "PreToolUse": [
            {
                "hooks": [
                    {
                        "timeout": 3600,
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/push-gate.sh",
                        "type": "command"
                    }
                ],
                "matcher": "Bash"
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/queue-guard.sh",
                        "type": "command"
                    }
                ]
            }
        ]
    }
}
